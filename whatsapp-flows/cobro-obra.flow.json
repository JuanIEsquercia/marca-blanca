{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "COBRO_FORM": ["COBRO_OK"]
  },
  "screens": [
    {
      "id": "COBRO_FORM",
      "title": "Cobro de obra",
      "terminal": false,
      "data": {
        "proyectos": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "sample-obra-1", "title": "Torre Norte" },
            { "id": "sample-obra-2", "title": "Barrio Cerrado Sur" }
          ]
        },
        "cuentas": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" } } },
          "__example__": [
            { "id": "sample-cuenta-1", "title": "Banco Galicia", "description": "ARS" }
          ]
        },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "If",
            "condition": "${data.error_message} != ''",
            "then": [
              { "type": "TextBody", "text": "⚠️ ${data.error_message}" }
            ]
          },
          {
            "type": "TextInput",
            "name": "monto",
            "label": "Monto",
            "input-type": "number",
            "helper-text": "Sin puntos de miles. Si tiene decimales usá punto, ej: 150000.50",
            "required": true
          },
          {
            "type": "RadioButtonsGroup",
            "name": "moneda",
            "label": "Moneda",
            "required": true,
            "data-source": [
              { "id": "ARS", "title": "ARS" },
              { "id": "USD", "title": "USD" }
            ]
          },
          {
            "type": "Dropdown",
            "name": "proyecto",
            "label": "Proyecto de obra",
            "required": true,
            "data-source": "${data.proyectos}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "accion": "elegir_proyecto",
                "obraId": "${form.proyecto}"
              }
            }
          },
          {
            "type": "Dropdown",
            "name": "cuenta",
            "label": "¿A qué cuenta ingresó?",
            "required": true,
            "data-source": "${data.cuentas}"
          },
          {
            "type": "Footer",
            "label": "Registrar cobro",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "accion": "confirmar",
                "monto": "${form.monto}",
                "moneda": "${form.moneda}",
                "obraId": "${form.proyecto}",
                "cuentaPropiaId": "${form.cuenta}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COBRO_OK",
      "title": "Listo",
      "terminal": true,
      "data": {
        "resumen": { "type": "string", "__example__": "$150.000 — Torre Norte — Banco Galicia" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "✅ Cobro registrado" },
          { "type": "TextBody", "text": "${data.resumen}" },
          {
            "type": "Footer",
            "label": "Listo",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
